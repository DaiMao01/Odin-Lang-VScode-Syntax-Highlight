{
  "name": "Odin-Lang",
  "displayName": "Odin Simple Syntax Highlighting",
  "description": "Syntax Highlighting for Odin",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.136.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "contributes": {
    "languages": [{
      "id": "odin",
      "aliases": ["Odin", "odin"],
      "extensions": [".odin"],
      "configuration": "./language-configuration.json"
    }],
    "grammars": [{
      "language": "odin",
      "scopeName": "source.odin",
      "path": "./syntaxes/odin.tmLanguage.json"
    }]
  }
}
