{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Odin",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#comment"
		},
		{
			"include": "#comments"
		},
		{
			"include": "#numbers"
		}
	],
	"repository": {
		"keywords": {
			"patterns": [{
				"name": "keyword.control.odin",
				"match": "\\b(if|while|for|return|proc|package|import)\\b"
			}]
		},
		"strings": {
			"name": "string.quoted.double.odin",
			"begin": "\"",
			"end": "\"",
			"patterns": [
				{
					"name": "constant.character.escape.odin",
					"match": "\\\\."
				}
			]
		},
		"comment": {
			"name": "comment.line.double-slash.odin",
			"begin": "//",
			"beginCaptures": {
				"0": {"name": "punctuation.definition.comment.odin"}
			},
				"end": "$",
				"patterns": [
					{
						"name": "keyword.todo.odin",
						"match": "\\b(TODO|FIXME|NOTE)\\b"
					}
			]
		},
		"comments": {
			
			"name": "comment.block.mylanguage",
			"begin": "/\\*",
			"beginCaptures": {
				"0": {
				"name": "punctuation.definition.comment.begin.mylanguage"
				}
			},
			"end": "\\*/",
			"endCaptures": {
				"0": {"name": "punctuation.definition.comment.end.mylanguage"}
			},
			"patterns": [
				{
				"name": "storage.type.class.todo.mylanguage",
				"match": "\\b(TODO|FIXME|NOTE|HACK)\\b"
				}
			]

		},
		"numbers": {
  				"name": "constant.numeric.mylanguage",
  				"match": "\\b(0[xX][0-9a-fA-F]+|0[bB][01]+|0[oO][0-7]+|([0-9]+(\\.[0-9]+)?|\\.[0-9]+)([eE][+-]?[0-9]+)?)\\b"
		}
	},
	"scopeName": "source.odin"
}