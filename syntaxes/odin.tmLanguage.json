{
	"$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
	"name": "Odin",
	"patterns": [
		{
			"include": "#keywords"
		},
		{
			"include": "#strings"
		},
		{
			"include": "#comment"
		},
		{
			"include": "#comments"
		},
		{
			"include": "#numbers"
		},
		{
			"include": "#basic-types"
		}
		
	],
	"repository": {
		"keywords": {
			"patterns": [{
				"name": "keyword.control.odin",
				"match": "\\b(if|while|for|return|else|switch|case|break|continue|fallthrough|proc|package|import|do|in|defer|when)\\b"
			}]
		},
		"strings": {
			"patterns": [
				{
					"name": "string.quoted.double.mylanguage",
					"begin": "\"",
					"beginCaptures": {
						"0": { "name": "punctuation.definition.string.begin.mylanguage" }
					},
					"end": "\"",
					"endCaptures": {
						"0": { "name": "punctuation.definition.string.end.mylanguage" }
					},
					"patterns": [
						{
						"name": "constant.character.escape.mylanguage",
						"match": "\\\\([abefnrtv\\\\'\"]|[0-7]{3}|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8})"
						}
					]
				},
				{
					"name": "string.quoted.single.mylanguage",
					"begin": "'",
					"beginCaptures": {
						"0": { "name": "punctuation.definition.string.begin.mylanguage" }
					},
					"end": "'",
					"endCaptures": {
						"0": { "name": "punctuation.definition.string.end.mylanguage" }
					},
					"patterns": [
						{
						"name": "constant.character.escape.mylanguage",
						"match": "\\\\(?:[abefnrtv\\\\'\"]|[0-7]{3}|x[0-9a-fA-F]{2}|u[0-9a-fA-F]{4}|U[0-9a-fA-F]{8})"
						}
					]
				}
          	]
		},
		"comment": {
			"name": "comment.line.double-slash.odin",
			"begin": "//",
			"beginCaptures": {
				"0": {"name": "punctuation.definition.comment.odin"}
			},
				"end": "$",
				"patterns": [
					{
						"name": "keyword.todo.odin",
						"match": "\\b(TODO|FIXME|NOTE)\\b"
					}
			]
		},
		"comments": {
			
			"name": "comment.block.mylanguage",
			"begin": "/\\*",
			"beginCaptures": {
				"0": {
				"name": "punctuation.definition.comment.begin.mylanguage"
				}
			},
			"end": "\\*/",
			"endCaptures": {
				"0": {"name": "punctuation.definition.comment.end.mylanguage"}
			},
			"patterns": [
				{
				"name": "storage.type.class.todo.mylanguage",
				"match": "\\b(TODO|FIXME|NOTE|HACK)\\b"
				}
			]

		},
		"numbers": {
  				"name": "constant.numeric.mylanguage",
  				"match": "\\b(0[xX][0-9a-fA-F]+|0[bB][01]+|0[oO][0-7]+|([0-9]+(\\.[0-9]+)?|\\.[0-9]+)([eE][+-]?[0-9]+)?)\\b"
		},
		"basic-types": {
			"patterns": [
				{
				"name": "storage.type.primitive.mylanguage",
				"match": "\\b(bool|b8|b16|b32|b64|int|i8|i16|i32|i64|i128|uint|u8|u16|u32|u64|u128|uintptr|i16le|i32le|i64le|i128le|u16le|u32le|u64le|u128le|i16be|i32be|i64be|i128be|u16be|u32be|u64be|u128be|f16|f32|f64|f16le|f32le|f64le|f16be|f32be|f64be|complex32|complex64|complex128|quaternion64|quaternion128|quaternion256|rune|string|cstring|rawptr|typeid|any)\\b"
				},
				{
				"name": "entity.name.type.mylanguage",
				"match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
				}
			]
		}
	},
	"scopeName": "source.odin"
}